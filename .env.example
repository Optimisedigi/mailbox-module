# Mailbox module configuration. Copy to `.env` and fill in.
# Never commit real values. See README.md → Configuration for what each one does.

# ── Required ────────────────────────────────────────────────────────────────
# Signs login sessions and Google sign-in requests. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# The app's own database (users, Gmail connections, stored client email,
# scheduled emails, reminders, settings). Local SQLite file, or libsql://… (Turso).
DATABASE_URL=file:./mailbox.db

# Google Cloud OAuth client (docs/google-cloud.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# At least one AI provider key, and a default model from that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
MIMO_API_KEY=
XAI_API_KEY=
# e.g. claude-sonnet-5.5, gpt-6-sol, kimi-k2.6, minimax-m3, mimo-v2.6-pro, grok-4.7
MAIL_AI_MODEL=

# ── Optional ────────────────────────────────────────────────────────────────
# Token for a hosted libSQL/Turso DATABASE_URL.
DATABASE_AUTH_TOKEN=

# Protects the scheduled-job routes (scheduled send, reminders, daily sync).
# Generate: openssl rand -hex 32
CRON_SECRET=

# Only for subscription logins (ChatGPT / Grok / Kimi) on the AI Auth page.
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENCRYPTION_KEY=

# Who the AI writes for, and your own email domains (comma-separated).
MAIL_ORG_NAME=
MAIL_ORG_DESCRIPTION=
MAIL_LANGUAGE=Australian English
MAIL_OWN_DOMAINS=

# Time zone for business days, schedule send and auto-refresh hours.
NEXT_PUBLIC_MAIL_TIME_ZONE=Australia/Sydney

# Defaults to <this app>/api/calendar/callback.
CALENDAR_REDIRECT_URI=

# Extra Google OAuth client for addresses the main one can't sign in
# (also GMAIL_ALT2_* and GMAIL_ALT3_*).
GMAIL_ALT_CLIENT_ID=
GMAIL_ALT_CLIENT_SECRET=
GMAIL_ALT_DOMAINS=
GMAIL_ALT_ACCOUNTS=
