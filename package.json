    "@payloadcms/next": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "googleapis": "171.4.0",
    "graphql": "16.13.0",
    "lexical": "0.50.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "0.14.0",
